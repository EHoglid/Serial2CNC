@page "/"
@using System.IO
@using System.IO.Ports
@using System.Text.Json
@inject TransferApiClient Api
@inject LiveLogStreamClient LogStream
@inject IConfiguration Configuration
@inject ILogger<Home> Logger
@implements IAsyncDisposable

<div class="transfer-page">
    @if (!string.IsNullOrWhiteSpace(StateErrorText))
    {
        <div class="service-banner" role="alert">
            <strong>Service connection interrupted</strong>
            <span>@StateErrorText</span>
            <span>Checking automatically. An existing transfer may still be running; its state cannot currently be confirmed.</span>
        </div>
    }
    <FluentCard Style="padding:14px;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap;">
            <FluentLabel Typography="Typography.PaneHeader">Remote Transfer Control</FluentLabel>
        </div>

        <div style="display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:10px;">
            <div style="display:flex; align-items:center; gap:8px;">
                <span>TCP</span>
                <FluentSwitch Value="@(Mode == ConnectionMode.Serial)" ValueChanged="OnModeChanged" AriaLabel="Connection mode: off for TCP, on for Serial (COM)" />
                <span>Serial (COM)</span>
            </div>

            <FluentButton Appearance="Appearance.Outline" AriaLabel="Settings" title="Settings" aria-expanded="@(ShowGeneralSettings && ShowAdvancedSettings ? "true" : "false")" aria-controls="general-settings connection-settings" Style="width:44px; height:44px; min-width:44px;" @onclick="ToggleSettingsPanels">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M10 2h4l.5 3 1.5 1 3-1 2 3.5-2.5 2v3l2.5 2-2 3.5-3-1-1.5 1-.5 3h-4l-.5-3-1.5-1-3 1-2-3.5 2.5-2v-3l-2.5-2L5 5l3 1 1.5-1Z" />
                    <circle cx="12" cy="12" r="3" />
                </svg>
            </FluentButton>
        </div>
        <p class="connection-summary"><span class="muted">Configured destination:</span> @ConnectionSummary</p>
    </FluentCard>

    @if (ShowGeneralSettings)
    {
        <FluentCard @key="_settingsLoadVersion" Id="general-settings" Style="padding:14px; margin-bottom:6px;">
            <FluentLabel Typography="Typography.Subtitle">General settings</FluentLabel>
            <FluentDivider Style="margin:8px 0 12px 0;" />

            <div class="settings-grid">
                <div>
                    <FluentTextField Label="Working directory on Agent" Placeholder="D:/project/" @bind-Value="WorkingDirectory" Immediate="true" Style="width:100%;" />
                </div>
                <div>
                    <FluentTextField Label="Allowed file extensions" Placeholder="*.* or *.nc" @bind-Value="FileExtensionFilter" Immediate="true" Style="width:100%;" />
                </div>
            </div>

        </FluentCard>
    }

    @if (ShowAdvancedSettings)
    {
        <FluentCard @key="(_settingsLoadVersion, nameof(ShowAdvancedSettings))" Id="connection-settings" Style="padding:14px;margin-bottom:6px;">
            <FluentLabel Typography="Typography.Subtitle">Connection settings</FluentLabel>
            <FluentDivider Style="margin:8px 0 12px 0;" />

            @if (Mode == ConnectionMode.Tcp)
            {
            <FluentLabel Typography="Typography.Body">TCP settings</FluentLabel>
            <div class="settings-grid">
                <div style="min-width:0;">
                    <FluentTextField Label="TCP host" @bind-Value="TcpHost" Immediate="true" Disabled="@(Mode != ConnectionMode.Tcp)" Style="width:100%; min-width:0;" />
                </div>
                <div style="min-width:0;">
                    <FluentNumberField Label="TCP port" @bind-Value="TcpPort" Immediate="true" Step="1" Disabled="@(Mode != ConnectionMode.Tcp)" Style="width:100%; min-width:0;" />
                </div>
            </div>
            <label class="checkbox-row">
                <input type="checkbox" @bind="TcpUseXonXoff" disabled="@(Mode != ConnectionMode.Tcp)" />
                <span>Use TCP XON/XOFF flow control</span>
            </label>

            }
            else
            {
            <FluentLabel Typography="Typography.Body">Serial settings</FluentLabel>
            <div class="settings-grid">
                <div style="min-width:0;">
                    <FluentSelect TOption="string" Label="COM port" @bind-Value="SerialPortName" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;">
                        @foreach (var port in _availableComPorts)
                        {
                            <FluentOption TOption="string" Value="@port">@port</FluentOption>
                        }
                    </FluentSelect>
                </div>
                <div style="min-width:0;">
                    <FluentSelect TOption="string" Label="Baud rate" @bind-Value="SerialBaudRate" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;">
                        @foreach (var baudRate in BaudRateOptions)
                        {
                            <FluentOption TOption="string" Value="@baudRate">@baudRate</FluentOption>
                        }
                    </FluentSelect>
                </div>
                <div style="min-width:0;">
                    <FluentSelect TOption="string" Label="Parity" @bind-Value="SerialParity" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;">
                        @foreach (var parity in ParityOptions)
                        {
                            <FluentOption TOption="string" Value="@parity">@parity</FluentOption>
                        }
                    </FluentSelect>
                </div>
                <div style="min-width:0;">
                    <FluentTextField Label="Data bits" @bind-Value="SerialDataBits" Immediate="true" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;" />
                </div>
                <div style="min-width:0;">
                    <FluentSelect TOption="string" Label="Stop bits" @bind-Value="SerialStopBits" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;">
                        @foreach (var stopBits in StopBitsOptions)
                        {
                            <FluentOption TOption="string" Value="@stopBits">@stopBits</FluentOption>
                        }
                    </FluentSelect>
                </div>
                <div style="min-width:0;">
                    <FluentSelect TOption="string" Label="Handshake" @bind-Value="SerialHandshake" Disabled="@(Mode != ConnectionMode.Serial)" Style="width:100%; min-width:0;">
                        @foreach (var handshake in HandshakeOptions)
                        {
                            <FluentOption TOption="string" Value="@handshake">@handshake</FluentOption>
                        }
                    </FluentSelect>
                </div>
            </div>
            }

            <details class="transfer-options">
                <summary>Transfer options</summary>
                <div class="settings-grid">
                    <div>
                        <FluentNumberField Label="Delay between lines (ms)" @bind-Value="DelayMs" Immediate="true" Step="1" Style="width:100%;" />
                    </div>
                </div>
                <label class="checkbox-row">
                    <input type="checkbox" @bind="UseOsp7000lFraming" />
                    <span>Use Okuma OSP7000L framing</span>
                </label>
            </details>
        </FluentCard>
    }
    @if (ShowGeneralSettings || ShowAdvancedSettings)
    {
        <section aria-label="Save or reload all settings">
            <div class="settings-actions">
                <FluentButton Appearance="Appearance.Accent" Disabled="@(!HasSettingsChanges)" @onclick="SaveSettingsAsync">Save</FluentButton>
                <FluentButton Appearance="Appearance.Outline" @onclick="LoadSettingsAndFilesAsync">Reload</FluentButton>
            </div>
            @if (!string.IsNullOrWhiteSpace(SettingsStatusText))
            {
                <div role="@(SettingsHasError ? "alert" : "status")" class="settings-status @(SettingsHasError ? "settings-error" : null)">
                    @if (SettingsHasError)
                    {
                        <strong>@SettingsErrorTitle</strong>
                    }
                    <span>@SettingsStatusText</span>
                    @if (SettingsHasError)
                    {
                        <span class="settings-error-help">Check the folder path and service connection. If the connection was lost while saving, reload to confirm what was saved.</span>
                    }
                </div>
            }
        </section>
    }

    <FluentCard Style="padding:14px; margin-bottom:6px;">
        <div style="display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap;">
            <FluentLabel Typography="Typography.Subtitle">File browser</FluentLabel>
            <FluentButton Appearance="Appearance.Outline" @onclick="ReloadCurrentFolderAsync">Refresh</FluentButton>
        </div>
        <FluentDivider Style="margin:8px 0 10px 0;" />

        <div style="display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:10px;">
            <nav class="breadcrumbs" aria-label="File location">
                @{
                    var crumbs = GetBreadcrumbs();
                }
                @for (var i = 0; i < crumbs.Count; i++)
                {
                    var crumb = crumbs[i];
                    <button type="button"
                            class="breadcrumb"
                            @onclick="() => OpenFolderAsync(crumb.Path)">@crumb.Label</button>

                    @if (i < crumbs.Count - 1)
                    {
                        <span style="opacity:0.7; padding:0 2px;">/</span>
                    }
                }
            </nav>
        </div>

        @if (!string.IsNullOrWhiteSpace(FileBrowserErrorText))
        {
            <div role="alert" class="error-message">@FileBrowserErrorText</div>
        }

        <div style="border:1px solid rgba(128,128,128,0.35); border-radius:6px; max-height:260px; overflow:auto; padding:4px 8px;">
            @if (!IsFileBrowserLoading && !string.IsNullOrWhiteSpace(CurrentFolderPath))
            {
                <button type="button"
                        class="file-row"
                        @onclick="NavigateUpAsync">
                    <span class="file-name">
                        <svg class="file-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v14" /></svg>
                        Parent folder
                    </span>
                    <span class="muted">Up</span>
                </button>
            }

            @if (IsFileBrowserLoading)
            {
                <div style="padding:8px 0;">Loading files...</div>
            }
            else if (_currentFolderItems.Count == 0)
            {
                <div style="padding:8px 0;">@(string.IsNullOrWhiteSpace(FileBrowserErrorText) ? "No folders or matching files." : "Folder listing could not be loaded.")</div>
            }
            else
            {
                @foreach (var node in _currentFolderItems)
                {
                    var isSelected = !node.IsDirectory && string.Equals(node.RelativePath, SelectedRelativePath, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="file-row @(isSelected ? "selected" : null)"
                            aria-pressed="@(!node.IsDirectory ? (isSelected ? "true" : "false") : null)"
                            title="@node.Name"
                            @onclick="() => OnNodeClickedAsync(node)">
                        <span class="file-name">
                            <svg class="file-icon" viewBox="0 0 24 24" aria-hidden="true">
                                @if (node.IsDirectory)
                                {
                                    <path d="M3 6h7l2 2h9v12H3Z" />
                                }
                                else
                                {
                                    <path d="M6 3h8l4 4v14H6ZM14 3v5h4M9 12h6M9 16h6" />
                                }
                            </svg>
                            <span class="file-label">@node.Name</span>
                        </span>
                        <span class="file-action">@(node.IsDirectory ? "Open" : isSelected ? "Selected" : "Select")</span>
                    </button>
                }
            }
        </div>

        <div class="selected-file">
            <div style="flex:1 1 auto; min-width:0;">
                <FluentTextField Label="Selected NC file path"
                                 Placeholder="Select a file from the list above"
                                 @bind-Value="FilePath"
                                 Style="width:100%;" />
            </div>
            <FluentButton Appearance="Appearance.Outline"
                          @onclick="ClearSelectedFile"
                          Disabled="@string.IsNullOrWhiteSpace(FilePath)">Clear</FluentButton>
        </div>

        @if (UseOsp7000lFraming)
        {
            <FluentTextField Label="Program Name" @bind-Value="ProgramName" Style="width:100%; margin-top:8px;" />
        }
    </FluentCard>

    <FluentCard Style="padding:14px; margin-bottom:6px;">
        <div class="transfer-header">
            <FluentLabel Typography="Typography.Subtitle">Transfer</FluentLabel>
            <span class="status-badge" role="status">@TransferStatusLabel</span>
        </div>
        <div class="transfer-actions">
            <FluentButton Appearance="Appearance.Accent" Disabled="@(IsTransferActionPending || TransferState?.IsRunning != false || string.IsNullOrWhiteSpace(FilePath))" @onclick="StartAsync">Start Send</FluentButton>
            <FluentButton Appearance="Appearance.Neutral" Disabled="@(IsTransferActionPending || TransferState?.IsRunning != true)" @onclick="CancelAsync">Cancel</FluentButton>
            <FluentButton Appearance="Appearance.Outline" Disabled="@IsTransferActionPending" @onclick="RefreshStateAsync">Refresh State</FluentButton>
        </div>
        <p class="muted">@(TransferState?.LastStatus ?? "Transfer state has not been confirmed.")</p>
        <pre class="transfer-response" aria-live="polite">@ResponseText</pre>
        @if (_latestError is not null)
        {
            <p class="error-message" role="alert">Latest log error: @_latestError.Message</p>
        }
        <details class="live-logs">
            <summary>Live log stream <span class="muted">(@_logEntries.Count)</span></summary>
            @if (_logEntries.Count == 0)
            {
                <FluentLabel>@(LogStream.IsConnected ? "Waiting for log events..." : "Log stream disconnected. Reconnecting automatically.")</FluentLabel>
            }
            else
            {
                <div class="log-entries">
                    @foreach (var entry in _logEntries)
                    {
                        <div style="color:@GetLogColor(entry.Level)">[@(entry.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss"))] [@entry.Source] [@entry.Level] @entry.Message</div>
                    }
                </div>
            }
        </details>
        <p class="log-connection" role="status">@(LogStream.IsConnected ? "Live logs connected to API." : "Live logs disconnected - reconnecting automatically.")</p>
        <details class="developer-tools">
            <summary>Developer tools</summary>
            <FluentAnchor Href="@SwaggerUrl" Target="_blank" Appearance="Appearance.Hypertext">Open Swagger</FluentAnchor>
        </details>

    </FluentCard>
</div>

@code {
    private const int MaxLogEntries = 250;
    private readonly CancellationTokenSource _statePollCts = new();
    private Task? _statePollTask;
    private TransferApiClient.TransferStateSnapshot? TransferState { get; set; }
    private bool IsTransferActionPending { get; set; }
    private string StateErrorText { get; set; } = string.Empty;
    private bool _settingsUnavailable;
    private bool _fileBrowserUnavailable;
    private LiveLogEntry? _latestError;

    private string ConnectionSummary => Mode == ConnectionMode.Tcp
        ? $"{TcpHost}:{TcpPort}"
        : $"{SerialPortName} · {SerialBaudRate} baud · Data bits: {SerialDataBits} · Parity: {SerialParity} · Stop bits: {SerialStopBits}";

    private string TransferStatusLabel => TransferState is null
        ? "State unknown"
        : TransferState.IsRunning ? "Transferring"
        : TransferState.LastStatus.StartsWith("Transfer failed", StringComparison.OrdinalIgnoreCase) ? "Failed"
        : TransferState.LastStatus.StartsWith("Transfer complete", StringComparison.OrdinalIgnoreCase) ? "Completed"
        : TransferState.LastStatus.StartsWith("Transfer canceled", StringComparison.OrdinalIgnoreCase) ? "Canceled"
        : "Idle";

    private ConnectionMode Mode { get; set; } = ConnectionMode.Tcp;
    private bool ShowGeneralSettings { get; set; }
    private bool ShowAdvancedSettings { get; set; }

    private string WorkingDirectory { get; set; } = string.Empty;
    private int _settingsLoadVersion;
    private SettingsSnapshot? _savedSettings;
    private SettingsSnapshot? _initialSettings;
    private bool HasSettingsChanges => _savedSettings is not null && CaptureSettings() != _savedSettings;

    private SettingsSnapshot CaptureSettings() => new(
        WorkingDirectory, FileExtensionFilter, TcpHost, TcpPort, TcpUseXonXoff,
        SerialPortName, SerialBaudRate, SerialDataBits, SerialParity, SerialStopBits,
        SerialHandshake, DelayMs, UseOsp7000lFraming);

    private sealed record SettingsSnapshot(
        string WorkingDirectory, string FileExtensionFilter, string TcpHost, int TcpPort, bool TcpUseXonXoff,
        string SerialPortName, string SerialBaudRate, string SerialDataBits, string SerialParity,
        string SerialStopBits, string SerialHandshake, int DelayMs, bool UseOsp7000lFraming);
    private string FileExtensionFilter { get; set; } = "*.*";
    private string SettingsStatusText { get; set; } = string.Empty;
    private bool SettingsHasError { get; set; }
    private string SettingsErrorTitle { get; set; } = "Settings could not be loaded";

    private bool IsFileBrowserLoading { get; set; }
    private string FileBrowserErrorText { get; set; } = string.Empty;
    private string CurrentFolderPath { get; set; } = string.Empty;
    private string SelectedRelativePath { get; set; } = string.Empty;
    private List<FileTreeNodeDto> _currentFolderItems = [];

    private string TcpHost { get; set; } = "192.168.1.50";
    private int TcpPort { get; set; } = 23;
    private bool TcpUseXonXoff { get; set; } = true;

    private string SerialPortName { get; set; } = "COM1";
    private string SerialBaudRate { get; set; } = "9600";
    private string SerialDataBits { get; set; } = "8";
    private string SerialParity { get; set; } = nameof(Parity.None);
    private string SerialStopBits { get; set; } = nameof(StopBits.One);
    private string SerialHandshake { get; set; } = nameof(Handshake.None);

    private bool UseOsp7000lFraming { get; set; } = true;
    private string FilePath { get; set; } = string.Empty;
    private string ProgramName { get; set; } = string.Empty;
    private int DelayMs { get; set; }
    private string ResponseText { get; set; } = "Ready.";
    private readonly List<LiveLogEntry> _logEntries = [];
    private readonly List<string> _availableComPorts = [];
    private string SwaggerUrl { get; set; } = string.Empty;

    private static readonly string[] BaudRateOptions = ["110", "300", "600", "1200", "2400", "4800", "9600", "19200", "38400", "57600", "115200"];
    private static readonly string[] ParityOptions = Enum.GetNames<Parity>();
    private static readonly string[] StopBitsOptions = [nameof(StopBits.None), nameof(StopBits.One), nameof(StopBits.Two), nameof(StopBits.OnePointFive)];
    private static readonly string[] HandshakeOptions = [nameof(Handshake.None), nameof(Handshake.XOnXOff), nameof(Handshake.RequestToSend), nameof(Handshake.RequestToSendXOnXOff)];

    protected override async Task OnInitializedAsync()
    {
        var apiBaseUrl = Configuration["Api:BaseUrl"] ?? string.Empty;
        var apiPublicBaseUrl = Configuration["Api:PublicBaseUrl"] ?? apiBaseUrl;
        SwaggerUrl = string.IsNullOrWhiteSpace(apiPublicBaseUrl)
            ? "/swagger"
            : $"{apiPublicBaseUrl.TrimEnd('/')}/swagger";

        RefreshComPorts();
        _initialSettings = CaptureSettings();
        await LoadSettingsAsync(preserveEdits: true);
        if (_settingsUnavailable)
        {
            StateErrorText = SettingsStatusText;
        }
        else
        {
            await UpdateTransferStateAsync(showResponse: false);
        }

        LogStream.LogReceived += OnLogReceived;
        await LogStream.StartAsync();
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _statePollTask = PollTransferStateAsync();
        }

        return Task.CompletedTask;
    }

    private async Task PollTransferStateAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_statePollCts.Token))
            {
                await InvokeAsync(async () =>
                {
                    await UpdateTransferStateAsync(showResponse: false);
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) when (_statePollCts.IsCancellationRequested)
        {
        }
    }

    private async Task UpdateTransferStateAsync(bool showResponse)
    {
        using var timeout = CancellationTokenSource.CreateLinkedTokenSource(_statePollCts.Token);
        timeout.CancelAfter(TimeSpan.FromSeconds(15));
        try
        {
            var recovering = TransferState is null;
            TransferState = await Api.GetStateAsync(timeout.Token);
            StateErrorText = string.Empty;
            if (_settingsUnavailable && CaptureSettings() == _initialSettings)
            {
                await LoadSettingsAndFilesAsync();
            }
            else if (recovering && _fileBrowserUnavailable)
            {
                await OpenFolderAsync(CurrentFolderPath);
            }
            if (showResponse)
            {
                ResponseText = FormatApiResponse(JsonSerializer.Serialize(TransferState, JsonSerializerOptions.Web));
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException
                                  && !_statePollCts.IsCancellationRequested)
        {
            TransferState = null;
            var message = GetServiceErrorMessage(ex);
            if (StateErrorText != message)
            {
                Logger.LogWarning(ex, "Unable to refresh transfer state.");
            }
            StateErrorText = message;
        }
    }

    private Task LoadSettingsAndFilesAsync() => LoadSettingsAsync(preserveEdits: false);

    private async Task LoadSettingsAsync(bool preserveEdits)
    {
        ServiceSettingsDto? settings;
        try
        {
            settings = await Api.GetSettingsAsync(_statePollCts.Token);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException
                                  && !_statePollCts.IsCancellationRequested)
        {
            _settingsUnavailable = _savedSettings is null;
            SettingsHasError = true;
            SettingsErrorTitle = "Settings could not be loaded";
            SettingsStatusText = GetServiceErrorMessage(ex);
            Logger.LogWarning(ex, "Unable to load settings.");
            return;
        }
        if (settings is null)
        {
            SettingsHasError = true;
            SettingsErrorTitle = "Settings could not be loaded";
            SettingsStatusText = "Unable to load settings from API.";
            return;
        }

        if (preserveEdits && CaptureSettings() != _initialSettings)
        {
            SettingsHasError = false;
            SettingsStatusText = "Services are available again. Reload to load saved settings; your edits have been kept.";
            return;
        }

        WorkingDirectory = settings.WorkingDirectory;
        _settingsLoadVersion++;
        FileExtensionFilter = settings.FileExtensionFilter;
        TcpHost = settings.TcpHost;
        TcpPort = settings.TcpPort;
        TcpUseXonXoff = settings.TcpUseXonXoff;
        SerialPortName = settings.SerialPortName;
        SerialBaudRate = settings.SerialBaudRate.ToString();
        SerialDataBits = settings.SerialDataBits.ToString();
        SerialParity = settings.SerialParity;
        SerialStopBits = settings.SerialStopBits;
        SerialHandshake = settings.SerialHandshake;
        DelayMs = settings.SendDelayMs;
        UseOsp7000lFraming = settings.UseOsp7000lFraming;
        SettingsStatusText = "Settings loaded.";
        SettingsHasError = false;
        _settingsUnavailable = false;
        _savedSettings = CaptureSettings();

        await OpenFolderAsync(string.Empty);
    }

    private async Task SaveSettingsAsync()
    {
        if (!HasSettingsChanges)
        {
            return;
        }

        var request = new UpdateServiceSettingsRequest
        {
            WorkingDirectory = WorkingDirectory,
            FileExtensionFilter = FileExtensionFilter,
            TcpHost = TcpHost,
            TcpPort = TcpPort,
            TcpUseXonXoff = TcpUseXonXoff,
            SerialPortName = SerialPortName,
            SerialBaudRate = ParseIntOrDefault(SerialBaudRate, 9600),
            SerialDataBits = ParseIntOrDefault(SerialDataBits, 8),
            SerialParity = SerialParity,
            SerialStopBits = SerialStopBits,
            SerialHandshake = SerialHandshake,
            SendDelayMs = DelayMs,
            UseOsp7000lFraming = UseOsp7000lFraming
        };

        ServiceSettingsDto? updated;
        try
        {
            updated = await Api.UpdateSettingsAsync(request, CancellationToken.None);
        }
        catch (Exception ex) when (ex is HttpRequestException or JsonException or OperationCanceledException)
        {
            SettingsHasError = true;
            SettingsErrorTitle = ex is HttpRequestException { StatusCode: System.Net.HttpStatusCode.Forbidden }
                ? "Access denied - settings not saved"
                : "Settings not saved";
            SettingsStatusText = GetServiceErrorMessage(ex);
            Logger.LogWarning(ex, "Unable to save settings.");
            return;
        }
        if (updated is null)
        {
            SettingsHasError = true;
            SettingsErrorTitle = "Settings not saved";
            SettingsStatusText = "Failed to save settings.";
            return;
        }

        SettingsStatusText = "Settings saved.";
        SettingsHasError = false;
        WorkingDirectory = updated.WorkingDirectory;
        FileExtensionFilter = updated.FileExtensionFilter;
        TcpHost = updated.TcpHost;
        TcpPort = updated.TcpPort;
        TcpUseXonXoff = updated.TcpUseXonXoff;
        SerialPortName = updated.SerialPortName;
        SerialBaudRate = updated.SerialBaudRate.ToString();
        SerialDataBits = updated.SerialDataBits.ToString();
        SerialParity = updated.SerialParity;
        SerialStopBits = updated.SerialStopBits;
        SerialHandshake = updated.SerialHandshake;
        DelayMs = updated.SendDelayMs;
        UseOsp7000lFraming = updated.UseOsp7000lFraming;
        _savedSettings = CaptureSettings();
        _settingsLoadVersion++;
        await OpenFolderAsync(string.Empty);
    }

    private void ToggleSettingsPanels()
    {
        var show = !ShowGeneralSettings || !ShowAdvancedSettings;
        ShowGeneralSettings = show;
        ShowAdvancedSettings = show;
    }

    private void OnModeChanged(bool useSerial)
    {
        Mode = useSerial
            ? ConnectionMode.Serial
            : ConnectionMode.Tcp;

        if (Mode == ConnectionMode.Serial)
        {
            RefreshComPorts();
        }
    }

    private async Task OnNodeClickedAsync(FileTreeNodeDto node)
    {
        if (node.IsDirectory)
        {
            await OpenFolderAsync(node.RelativePath);
            return;
        }

        SelectFile(node);
    }

    private async Task OpenFolderAsync(string relativePath)
    {
        FileBrowserErrorText = string.Empty;
        IsFileBrowserLoading = true;
        try
        {
            var items = await Api.GetDirectoryChildrenAsync(relativePath, CancellationToken.None);
            _fileBrowserUnavailable = false;
            _currentFolderItems = items
                .OrderByDescending(node => node.IsDirectory)
                .ThenBy(node => node.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            CurrentFolderPath = relativePath;
        }
        catch (Exception ex)
        {
            _currentFolderItems = [];
            _fileBrowserUnavailable = ex is HttpRequestException http && (http.StatusCode is null || (int)http.StatusCode >= 500);
            FileBrowserErrorText = GetServiceErrorMessage(ex);
        }
        finally
        {
            IsFileBrowserLoading = false;
        }
    }

    private Task ReloadCurrentFolderAsync()
    {
        return OpenFolderAsync(CurrentFolderPath);
    }

    private Task NavigateUpAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentFolderPath))
        {
            return Task.CompletedTask;
        }

        var normalized = CurrentFolderPath.Replace('\\', '/').Trim('/');
        var separatorIndex = normalized.LastIndexOf('/');
        var parentPath = separatorIndex < 0 ? string.Empty : normalized[..separatorIndex];
        return OpenFolderAsync(parentPath);
    }

    private IReadOnlyList<(string Label, string Path)> GetBreadcrumbs()
    {
        var crumbs = new List<(string Label, string Path)> { ("Root", string.Empty) };
        if (string.IsNullOrWhiteSpace(CurrentFolderPath))
        {
            return crumbs;
        }

        var parts = CurrentFolderPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var aggregate = string.Empty;
        foreach (var part in parts)
        {
            aggregate = string.IsNullOrEmpty(aggregate) ? part : $"{aggregate}/{part}";
            crumbs.Add((part, aggregate));
        }

        return crumbs;
    }

    private void ClearSelectedFile()
    {
        SelectedRelativePath = string.Empty;
        FilePath = string.Empty;
        ProgramName = string.Empty;
    }

    private void SelectFile(FileTreeNodeDto node)
    {
        SelectedRelativePath = node.RelativePath;
        FilePath = BuildAbsolutePathFromRelative(node.RelativePath);
        if (UseOsp7000lFraming)
        {
            ProgramName = $"{Path.GetFileNameWithoutExtension(node.Name)}.MIL".ToUpperInvariant();
        }
    }

    private string BuildAbsolutePathFromRelative(string relativePath)
    {
        if (string.IsNullOrWhiteSpace(WorkingDirectory))
        {
            return relativePath;
        }

        var normalized = relativePath.Replace('/', Path.DirectorySeparatorChar);
        return Path.Combine(WorkingDirectory, normalized);
    }

    private void RefreshComPorts()
    {
        var ports = SerialPort.GetPortNames();
        Array.Sort(ports, StringComparer.OrdinalIgnoreCase);

        _availableComPorts.Clear();
        _availableComPorts.AddRange(ports);

        if (_availableComPorts.Count == 0)
        {
            _availableComPorts.Add("COM1");
        }

        if (!_availableComPorts.Contains(SerialPortName, StringComparer.OrdinalIgnoreCase))
        {
            SerialPortName = _availableComPorts[0];
        }
    }

    private void OnLogReceived(LiveLogEntry entry)
    {
        _ = InvokeAsync(() =>
        {
            _logEntries.Insert(0, entry);
            if (string.Equals(entry.Level, "Error", StringComparison.OrdinalIgnoreCase))
            {
                _latestError = entry;
            }

            if (_logEntries.Count > MaxLogEntries)
            {
                _logEntries.RemoveRange(MaxLogEntries, _logEntries.Count - MaxLogEntries);
            }

            StateHasChanged();
        });
    }

    private async Task StartAsync()
    {
        if (IsTransferActionPending || TransferState?.IsRunning != false)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(FilePath))
        {
            ResponseText = "Select an NC file before starting transfer.";
            return;
        }

        IsTransferActionPending = true;
        try
        {
            var request = new TransferRequest
            {
                Mode = Mode,
                Tcp = new TcpConnectionOptions
                {
                    Host = TcpHost,
                    Port = TcpPort,
                    UseXonXoff = TcpUseXonXoff
                },
                Serial = new SerialConnectionOptions
                {
                    PortName = SerialPortName,
                    BaudRate = ParseIntOrDefault(SerialBaudRate, 9600),
                    DataBits = ParseIntOrDefault(SerialDataBits, 8),
                    Parity = ParseEnumOrDefault(SerialParity, Parity.None),
                    StopBits = ParseEnumOrDefault(SerialStopBits, StopBits.One),
                    Handshake = ParseEnumOrDefault(SerialHandshake, Handshake.None)
                },
                Transfer = new TransferOptions
                {
                    FilePath = FilePath,
                    ProgramName = string.IsNullOrWhiteSpace(ProgramName) ? null : ProgramName,
                    SendDelayMs = DelayMs,
                    UseOsp7000lFraming = UseOsp7000lFraming
                }
            };

            ResponseText = FormatApiResponse(await Api.StartAsync(request, CancellationToken.None));
            await UpdateTransferStateAsync(showResponse: false);
        }
        catch (Exception ex)
        {
            ResponseText = $"Start could not be confirmed. {GetServiceErrorMessage(ex)} Check transfer state before trying again.";
            Logger.LogWarning(ex, "Unable to start transfer.");
            await UpdateTransferStateAsync(showResponse: false);
        }
        finally
        {
            IsTransferActionPending = false;
        }
    }

    private async Task CancelAsync()
    {
        if (IsTransferActionPending || TransferState?.IsRunning != true)
        {
            return;
        }

        IsTransferActionPending = true;
        try
        {
            ResponseText = FormatApiResponse(await Api.CancelAsync(CancellationToken.None));
            await UpdateTransferStateAsync(showResponse: false);
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            ResponseText = $"Cancel could not be confirmed. {GetServiceErrorMessage(ex)} The transfer may still be running.";
            Logger.LogWarning(ex, "Unable to cancel transfer.");
            await UpdateTransferStateAsync(showResponse: false);
        }
        finally
        {
            IsTransferActionPending = false;
        }
    }

    private async Task RefreshStateAsync()
    {
        await UpdateTransferStateAsync(showResponse: true);
    }

    private static string GetServiceErrorMessage(Exception exception) => exception switch
    {
        JsonException => "A service returned an invalid response. Check the API and Agent logs.",
        OperationCanceledException => "The service did not respond in time. Check the API and Agent connection.",
        _ => exception.Message
    };

    public async ValueTask DisposeAsync()
    {
        await _statePollCts.CancelAsync();
        if (_statePollTask is not null)
        {
            await _statePollTask;
        }

        _statePollCts.Dispose();
        LogStream.LogReceived -= OnLogReceived;
        await LogStream.DisposeAsync();
    }

    private static int ParseIntOrDefault(string value, int fallback)
    {
        return int.TryParse(value, out var parsed) ? parsed : fallback;
    }

    private static TEnum ParseEnumOrDefault<TEnum>(string value, TEnum fallback) where TEnum : struct, Enum
    {
        return Enum.TryParse<TEnum>(value, ignoreCase: true, out var parsed) ? parsed : fallback;
    }

    private static string GetLogColor(string? level)
    {
        if (string.Equals(level, "Error", StringComparison.OrdinalIgnoreCase))
        {
            return "#ff6b6b";
        }

        if (string.Equals(level, "Warning", StringComparison.OrdinalIgnoreCase))
        {
            return "#ffb366";
        }

        return "inherit";
    }

    private static string FormatApiResponse(string raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return "No response.";
        }

        try
        {
            using var doc = JsonDocument.Parse(raw);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
            {
                return raw;
            }

            var hasLastStatus = doc.RootElement.TryGetProperty("lastStatus", out var lastStatusProperty);
            var hasRunning = doc.RootElement.TryGetProperty("isRunning", out var isRunningProperty);
            var hasStartedAt = doc.RootElement.TryGetProperty("startedAt", out var startedAtProperty);

            if (!hasLastStatus && !hasRunning && !hasStartedAt)
            {
                return raw;
            }

            var status = hasLastStatus ? lastStatusProperty.GetString() : null;
            var isRunning = hasRunning && isRunningProperty.ValueKind is JsonValueKind.True or JsonValueKind.False
                ? isRunningProperty.GetBoolean()
                : (bool?)null;
            var startedAt = hasStartedAt && startedAtProperty.ValueKind == JsonValueKind.String
                ? startedAtProperty.GetString()
                : null;

            var lines = new List<string>();
            if (!string.IsNullOrWhiteSpace(status))
            {
                lines.Add(status);
            }

            if (isRunning.HasValue)
            {
                lines.Add(isRunning.Value ? "Transfer is running." : "Transfer is idle.");
            }

            if (!string.IsNullOrWhiteSpace(startedAt) && DateTimeOffset.TryParse(startedAt, out var started))
            {
                lines.Add($"Started: {started.ToLocalTime():yyyy-MM-dd HH:mm:ss}");
            }

            return lines.Count > 0 ? string.Join(Environment.NewLine, lines) : raw;
        }
        catch
        {
            return raw;
        }
    }
}
