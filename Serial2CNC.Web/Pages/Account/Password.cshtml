@page
@model Serial2CNC.Web.Pages.Account.PasswordModel
@{
    ViewData["Title"] = "Change password";
}
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <label asp-for="CurrentPassword">Current password</label>
    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" required />
    <label asp-for="NewPassword">New password (at least 12 characters)</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" required minlength="12" />
    <label asp-for="ConfirmPassword">Confirm new password</label>
    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
    <div><button type="submit">Change password and sign out</button></div>
</form>
