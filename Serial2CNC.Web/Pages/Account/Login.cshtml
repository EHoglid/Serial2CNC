@page
@model Serial2CNC.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<form method="post">
    <div asp-validation-summary="All" role="alert"></div>
    <input type="hidden" asp-for="ReturnUrl" />
    <label asp-for="UserName">Username</label>
    <input asp-for="UserName" autocomplete="username" required maxlength="256" />
    <label asp-for="Password"></label>
    <input asp-for="Password" type="password" autocomplete="current-password" required />
    <div><button type="submit">Sign in</button></div>
</form>
<p>Accounts are created by your Serial2CNC administrator.</p>
