<Project Sdk="WixToolset.Sdk/5.0.1">

  <PropertyGroup>
    <InstallerPlatform>x64</InstallerPlatform>
    <OutputName>Serial2CNC</OutputName>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <!-- SQLite needs DefaultLanguage="0" for ICE60; WIX1101 warns because its language resource is absent. -->
    <SuppressSpecificWarnings>$(SuppressSpecificWarnings);1101</SuppressSpecificWarnings>

    <AgentPublishDir Condition="'$(AgentPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\Agent</AgentPublishDir>
    <ApiPublishDir Condition="'$(ApiPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\Api</ApiPublishDir>
    <WebPublishDir Condition="'$(WebPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\Web</WebPublishDir>
    <DesktopPublishDir Condition="'$(DesktopPublishDir)' == ''">$(MSBuildThisFileDirectory)..\artifacts\publish\Desktop</DesktopPublishDir>
    <DefineConstants>$(DefineConstants);AgentPublishDir=$(AgentPublishDir);ApiPublishDir=$(ApiPublishDir);WebPublishDir=$(WebPublishDir);DesktopPublishDir=$(DesktopPublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.1" />
  </ItemGroup>

</Project>
