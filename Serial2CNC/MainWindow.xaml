<Window x:Class="Serial2CNC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Serial2CNC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Style="{DynamicResource MaterialDesignWindow}"
        IsEnabled="{Binding IsInteractive}"
        Title="Serial2CNC - Send2CNC"
        Icon="Assets/Serial2CNC.ico"
        Height="760"
        Width="980"
        MinHeight="680"
        MinWidth="900">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.78" />
        </Style>

        <Style x:Key="ErrorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="OrangeRed" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,2,0,6" />
            <Style.Triggers>
                <Trigger Property="Text" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidatedTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="OrangeRed" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ValidatedComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="BorderBrush" Value="OrangeRed" />
                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <materialDesign:Card Grid.Row="0" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="19" Background="{DynamicResource PrimaryHueMidBrush}" Margin="0,0,12,0">
                        <Grid>
                            <Canvas Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Rectangle Width="14" Height="10" Canvas.Left="4" Canvas.Top="6" RadiusX="1" RadiusY="1" Fill="#FFFFFFFF" />
                                <Rectangle Width="4" Height="4" Canvas.Left="9" Canvas.Top="9" Fill="{DynamicResource PrimaryHueMidBrush}" />
                                <Rectangle Width="2" Height="14" Canvas.Left="2" Canvas.Top="4" Fill="#FFFFFFFF" />
                                <Rectangle Width="2" Height="14" Canvas.Left="18" Canvas.Top="4" Fill="#FFFFFFFF" />
                            </Canvas>
                        </Grid>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Serial2CNC" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Connection" Opacity="0.72" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton Content="TCP (USR-W610)" IsChecked="{Binding UseTcp}" Margin="0,0,16,0" />
                    <RadioButton Content="Serial / COM" IsChecked="{Binding UseSerial}" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button x:Name="OpenWebAppButton"
                            Content="Open web app"
                            Visibility="{Binding IsWebRunning, Converter={StaticResource BoolToVisibilityConverter}}"
                            Margin="0,0,8,0"
                            Command="{Binding OpenWebCommand}"
                            ToolTip="Open the running web application in your browser" />
                    <Button x:Name="AdvancedSettingsButton"
                            Command="{Binding ToggleSettingsCommand}"
                            ToolTip="Show or hide advanced connection settings">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CogOutline" Width="16" Height="16" Margin="0,0,6,0" />
                            <TextBlock Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </materialDesign:Card>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,10" Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibilityConverter}}"
                      MaxHeight="300" VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Connection settings (advanced)" FontWeight="SemiBold" Margin="0,0,0,8" />
                <materialDesign:Card Margin="0,0,0,10" Padding="12">
                    <StackPanel>
                        <WrapPanel>
                            <CheckBox Content="Enable built-in web application (LAN)" IsChecked="{Binding WebEnabled}"
                                      IsEnabled="{Binding CanConfigureWeb}" VerticalAlignment="Center" Margin="0,0,16,0" />
                            <TextBlock Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding WebPort, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditWebPort}" Width="70" Margin="0,0,12,0" />
                            <Button Content="Open web app" Command="{Binding OpenWebCommand}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding WebStatus}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Trusted LAN only; no login. Configure the web program folder and destination in the browser."
                                   Opacity="0.72" TextWrapping="Wrap" />
                    </StackPanel>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="Theme:" Style="{StaticResource FieldLabelStyle}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton Content="System" GroupName="ThemePreference" IsChecked="{Binding IsSystemTheme}" Margin="0,0,16,0" />
                            <RadioButton Content="Light" GroupName="ThemePreference" IsChecked="{Binding IsLightTheme}" Margin="0,0,16,0" />
                            <RadioButton Content="Dark" GroupName="ThemePreference" IsChecked="{Binding IsDarkTheme}" />
                        </StackPanel>
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card IsEnabled="{Binding UseTcp}" Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="TCP Settings" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="IP Address:" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,0" Style="{StaticResource ValidatedTextBoxStyle}" Text="{Binding TcpHost, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" materialDesign:HintAssist.Hint="IP Address" />

                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Port:" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,0" Style="{StaticResource ValidatedTextBoxStyle}" Text="{Binding TcpPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" materialDesign:HintAssist.Hint="Port" />

                        <TextBlock Text="{Binding TcpHostError}" Grid.Row="2" Grid.Column="1" Style="{StaticResource ErrorTextStyle}" />
                        <TextBlock Text="{Binding TcpPortError}" Grid.Row="2" Grid.Column="3" Style="{StaticResource ErrorTextStyle}" />

                        <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Content="Use TCP XON/XOFF flow control" IsChecked="{Binding TcpUseXonXoff}" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,0,10" Padding="12" IsEnabled="{Binding UseSerial}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Text="Serial Settings" Style="{StaticResource SectionTitleStyle}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="COM Port:" Style="{StaticResource FieldLabelStyle}" />
                        <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,6">
                            <Button Content="Refresh" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,2" Command="{Binding RefreshPortsCommand}" />
                            <ComboBox Style="{StaticResource ValidatedComboBoxStyle}" ItemsSource="{Binding AvailableComPorts}" Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" IsEditable="True" />
                        </DockPanel>

                        <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Text="Baud Rate:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,6" IsEditable="True" ItemsSource="{Binding BaudRateOptions}" Text="{Binding BaudRate, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Parity:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,6" ItemsSource="{Binding ParityOptions}" SelectedItem="{Binding Parity}" />

                        <TextBlock Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Text="Data Bits:" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="2" Grid.Column="3" Margin="0,0,0,6" Text="{Binding DataBits, UpdateSourceTrigger=PropertyChanged}" materialDesign:HintAssist.Hint="Data Bits" />

                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Stop Bits:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,12,0" ItemsSource="{Binding StopBitsOptions}" SelectedItem="{Binding StopBits}" />

                        <TextBlock Grid.Row="3" Grid.Column="2" VerticalAlignment="Center" Text="Handshake:" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding HandshakeOptions}" SelectedItem="{Binding Handshake}" />
                    </Grid>
                </materialDesign:Card>

                <materialDesign:Card Margin="0,0,0,10" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Send settings" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Delay between lines (ms):" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,0" Style="{StaticResource ValidatedTextBoxStyle}" Text="{Binding SendDelay, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" materialDesign:HintAssist.Hint="0" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Text="Okuma settings" FontWeight="SemiBold" Margin="0,0,0,4" />

                        <CheckBox
                                  Grid.Row="4"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="3"
                                  Content="Use Okuma OSP7000L framing (${NAME}% ... %)"
                                  IsChecked="{Binding UseOsp7000lFraming}" />
                    </Grid>
                </materialDesign:Card>
        </StackPanel>
        </ScrollViewer>
        <materialDesign:Card Grid.Row="3" Margin="0,0,0,10" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="File and OSP7000L Options" Style="{StaticResource SectionTitleStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="NC File:" Style="{StaticResource FieldLabelStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,10,6" Style="{StaticResource ValidatedTextBoxStyle}" Text="{Binding FilePath, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" materialDesign:HintAssist.Hint="Path to .nc file" />
                <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Command="{Binding BrowseCommand}" Margin="0,0,0,6" VerticalAlignment="Bottom" />

                <TextBlock Text="{Binding FilePathError}" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorTextStyle}" />

                <TextBlock x:Name="ProgramNameLabel"
                           Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="Program Name:"
                           Style="{StaticResource FieldLabelStyle}"
                           Visibility="{Binding UseOsp7000lFraming, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Grid x:Name="ProgramNamePanel"
                      Grid.Row="3"
                      Grid.Column="1"
                      Grid.ColumnSpan="2"
                      Margin="0,0,0,4"
                      Visibility="{Binding UseOsp7000lFraming, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBox x:Name="ProgramNameTextBox"
                             Text="{Binding ProgramName, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding IsProgramNameReadOnly}"
                             ToolTip="Leave empty to auto-generate from file name as UPPERCASE .MIL"
                             materialDesign:HintAssist.Hint="Optional program name"
                             MouseDoubleClick="ProgramNameTextBox_MouseDoubleClick"
                             LostKeyboardFocus="ProgramNameTextBox_LostKeyboardFocus">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter Property="Opacity" Value="0.72" />
                                <Style.Triggers>
                                    <Trigger Property="IsReadOnly" Value="False">
                                        <Setter Property="Cursor" Value="IBeam" />
                                        <Setter Property="Opacity" Value="1" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>

                <TextBlock Grid.Row="4"
                           Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="0,2,0,0"
                           FontSize="11"
                           Opacity="0.70"
                           Text="Double-click to edit." 
                           Visibility="{Binding UseOsp7000lFraming, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </materialDesign:Card>

        <materialDesign:Card Grid.Row="5" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Transfer and Log" Style="{StaticResource SectionTitleStyle}" />
                    <Button Grid.Column="1" Content="Start Send" Command="{Binding StartCommand}" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelCommand}" />
                </Grid>

                <TextBlock Grid.Row="1" Text="{Binding Status}" Margin="0,0,0,6" FontWeight="SemiBold" />
                <TextBox x:Name="LogTextBox" Text="{Binding Log, Mode=OneWay}" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Consolas" materialDesign:HintAssist.Hint="Transfer output" />
            </Grid>
        </materialDesign:Card>

        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Grid.Row="6" Height="20" Minimum="0" Maximum="100" />
    </Grid>
</Window>
